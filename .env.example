# 서버 포트
PORT=4000

# 개발 중 모든 출처(origin) 허용 여부 (true/false)
# 배포 시에는 false로 바꾸고 ALLOWED_ORIGIN을 지정하는 것을 권장
CORS_ALLOW_ALL=true

# 국토교통부 TAGO 오픈API 서비스키 (공공데이터포털 data.go.kr에서 발급)
# - 버스정류소정보서비스(BusSttnInfoInqireService)는 이미 활용 중입니다.
# - 버스도착정보서비스(ArvlInfoInqireService)는 별도로 활용신청이 필요합니다.
TAGO_SERVICE_KEY=

# 한국산업인력공단 큐넷(Q-net) 국가자격 시험일정 조회 서비스 (공공데이터포털에서 발급)
# https://www.data.go.kr/data/15074408/openapi.do 에서 "활용신청"
# data.go.kr은 계정마다 인증키가 하나라서, TAGO_SERVICE_KEY와 같은 계정으로
# 신청했다면 같은 값을 그대로 써도 될 가능성이 높습니다 (확실하지 않으니 안 되면
# 이 API로 별도 활용신청 후 발급된 키를 넣어주세요).
QNET_SERVICE_KEY=
